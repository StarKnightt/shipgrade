# Shipgrade environment variables. ALL OPTIONAL.
# The app runs fully on its deterministic heuristic engine with no keys set.

# ---------------------------------------------------------------------------
# AI (OpenAI-compatible Chat Completions: OpenAI, Groq, etc.)
# Enables the AI verdict + roast, the AI checkout explanation, and the
# LLM-driven PayPal checkout agent. Without it, rules do everything.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model for the tool-calling checkout agent (defaults to OPENAI_MODEL).
# OPENAI_AGENT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# PayPal (SANDBOX ONLY). developer.paypal.com > Apps & Credentials > Sandbox.
# Shipgrade refuses any PAYPAL_ENVIRONMENT other than "sandbox".
# ---------------------------------------------------------------------------
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's Webhooks section (signature verification).
PAYPAL_WEBHOOK_ID=

# Simulate PayPal in the checkout agent (no network, placeholder ids).
# Handy for UI work before you have sandbox credentials.
# PAYPAL_DRY_RUN=true

# HMAC secret for signed preview / unlock tokens. Defaults to one derived from
# PAYPAL_CLIENT_SECRET; set it explicitly on Vercel. Generate: openssl rand -hex 32
SHIPGRADE_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Shipgrade's own offers (paid via PayPal)
# ---------------------------------------------------------------------------
# SHIPGRADE_BRAND_NAME=Shipgrade
# SHIPGRADE_DEEP_AUDIT_PRICE=9.00
# SHIPGRADE_WATCH_PRICE=19.00
# Created once by: pnpm paypal:setup  (prints the plan id)
SHIPGRADE_WATCH_PLAN_ID=
# Hourly rate used when the agent drafts a fix invoice (stretch).
# SHIPGRADE_FIX_HOURLY_RATE=60
